generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Multi-tenancy
// ─────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  subscriptions Subscription[]
  services      Service[]
  payments      Payment[]
  alertLogs     AlertLog[]
  orders         Order[]
  clientAccounts ClientAccount[]
  testimonials   Testimonial[]

  @@map("organizations")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  role           Role     @default(ADMIN)
  orgId          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  accounts Account[]
  sessions Session[]

  @@index([orgId])
  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────
// Service catalog
// ─────────────────────────────────────────

model Service {
  id          String          @id @default(cuid())
  orgId       String
  name        String
  category    ServiceCategory
  description String?
  iconUrl     String?
  costPrice   Decimal?        @db.Decimal(10, 2)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  orderItems    OrderItem[]

  @@index([orgId])
  @@map("services")
}

enum ServiceCategory {
  AI
  STREAMING
  EDITING
  PRODUCTIVITY
  CLOUD
  MUSIC
  SECURITY
  GAMING
  OTHER
}

// ─────────────────────────────────────────
// Clients
// ─────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  payments      Payment[]
  orders        Order[]
  account       ClientAccount?

  @@index([orgId])
  @@map("clients")
}

// ─────────────────────────────────────────
// Subscriptions (core entity)
// ─────────────────────────────────────────

model Subscription {
  id           String             @id @default(cuid())
  orgId        String
  clientId     String
  serviceId    String
  status       SubscriptionStatus @default(ACTIVE)

  purchaseDate DateTime
  durationDays Int
  expiryDate   DateTime

  salePrice    Decimal            @db.Decimal(10, 2)
  credentials  String?            @db.Text  // encrypted login info
  notes        String?            @db.Text
  autoRenew    Boolean            @default(false)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  org      Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client   Client                @relation(fields: [clientId], references: [id])
  service  Service               @relation(fields: [serviceId], references: [id])
  payments Payment[]
  alerts   AlertLog[]
  history  SubscriptionHistory[]

  @@index([orgId, status])
  @@index([expiryDate])
  @@index([clientId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

model SubscriptionHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  action         String
  previousExpiry DateTime?
  newExpiry      DateTime?
  note           String?
  performedAt    DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_history")
}

// ─────────────────────────────────────────
// Payments
// ─────────────────────────────────────────

model Payment {
  id             String        @id @default(cuid())
  orgId          String
  clientId       String
  subscriptionId String?
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(DUE)
  method         PaymentMethod?
  paidAt         DateTime?
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([orgId, status])
  @@index([clientId])
  @@map("payments")
}

enum PaymentStatus {
  PAID
  DUE
  PARTIAL
  REFUNDED
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  BANK_TRANSFER
  CARD
  OTHER
}

// ─────────────────────────────────────────
// Alert logs (prevent duplicate sends)
// ─────────────────────────────────────────

model AlertLog {
  id             String    @id @default(cuid())
  orgId          String
  subscriptionId String
  alertType      AlertType
  sentAt         DateTime  @default(now())
  deliveredTo    String
  success        Boolean   @default(true)

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, alertType, sentAt])
  @@index([subscriptionId])
  @@map("alert_logs")
}

enum AlertType {
  EXPIRY_3DAY
  EXPIRY_1DAY
  EXPIRY_TODAY
  RENEWAL_CONFIRM
}

// ─────────────────────────────────────────
// Storefront Orders
// ─────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  orgId       String
  clientId    String?
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  customerName  String
  customerEmail String
  customerPhone String?
  customerNote  String?  @db.Text

  totalAmount Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client?      @relation(fields: [clientId], references: [id])
  items  OrderItem[]

  @@index([orgId, status])
  @@index([customerEmail])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  serviceId   String
  serviceName String
  duration    Int
  price       Decimal @db.Decimal(10, 2)
  quantity    Int     @default(1)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────────────────
// Client portal accounts (separate from admin Users)
// ─────────────────────────────────────────

model ClientAccount {
  id             String   @id @default(cuid())
  orgId          String
  clientId       String   @unique   // links to existing Client record
  email          String   @unique
  hashedPassword String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org    Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client                @relation(fields: [clientId], references: [id])
  sessions ClientSession[]

  @@index([orgId])
  @@map("client_accounts")
}

model ClientSession {
  id        String   @id @default(cuid())
  accountId String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  account ClientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

@@map("client_sessions")
}

// ─────────────────────────────────────────
// Testimonials
// ─────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  location  String?
  text      String   @db.Text
  rating    Int      @default(5)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("testimonials")
}
